<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 构建生效：信任用户安装的 CA，供 Reqable 解密 HTTPS；release 不引用本配置。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
